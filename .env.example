# Semrush Keyword Gap Scraper — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# Required for browser-based login (Keyword Gap scraper)
SEMRUSH_EMAIL=victor.g@legendary-parts.com
SEMRUSH_PASSWORD=a!q,p,PU#sjY8-Z

# Required for API-based tools (semrush_competitor_keywords.py)
SEMRUSH_API_KEY=your_semrush_api_key_here

# Other project keys
OPENAI_API_KEY=
GOOGLE_SHEET_ID=
AHREFS_API_KEY=
SERPER_API_KEY=
FIRECRAWL_API_KEY=

# Google Drive — blog upload and translation doc storage
GOOGLE_SERVICE_ACCOUNT_PATH=secrets/legendary-parts-203a804edea2.json
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHARED_DRIVE_ID=

# Shopify Admin API — product and blog URL lookup (replaces config/product_urls.csv and blog_urls.csv)
# Docs: https://shopify.dev/docs/api/admin-graphql
SHOPIFY_ADMIN_API_TOKEN=shpat_your_token_here
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com    # myshopify.com domain — used for API calls only
SHOPIFY_STORE_URL=https://your-store.com         # public-facing domain — used to construct localized URLs
SHOPIFY_OEM_METAFIELD=custom.product_ref          # metafield namespace.key storing OEM numbers on products
SHOPIFY_BLOG_ID=                                 # numeric Shopify blog ID (optional; narrows article search)

# Translation workflow
TRANSLATION_MODEL=claude-sonnet-4-5

# Claude Code must be installed and authenticated on the host (claude.ai/code)

# SMTP — email notification after translations complete
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-app-password
NOTIFY_EMAIL=haleema@legendary-parts.com

# Trello Validation Gate — sits between English blog generation and translation
# Get your API key and token at: https://trello.com/power-ups/admin
TRELLO_API_KEY=
TRELLO_API_TOKEN=
TRELLO_BOARD_ID=1x4Uql2u
TRELLO_PENDING_LIST_NAME=To Do
TRELLO_TRANSLATING_LIST_NAME=Doing
TRELLO_DONE_LIST_NAME=Done
TRELLO_CHECKLIST_NAME=Validations
TRELLO_CHECKLIST_ITEM_1=Validated by Haleema
TRELLO_CHECKLIST_ITEM_2=Validated by Jeremy
TRELLO_POLLING_INTERVAL_MINUTES=5
